{
  "title": "Kafka Topic: {{TOPIC_NAME}}",
  "uid": "topic-{{TOPIC_NAME}}",
  "tags": ["self-service-kafka", "auto-generated"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "topic",
        "type": "constant",
        "current": { "value": "{{TOPIC_NAME}}" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Messages In / sec ({{TOPIC_NAME}})",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(kafka_topic_messages_in_total{topic=\"{{TOPIC_NAME}}\"}[5m]))" }
      ]
    },
    {
      "id": 2,
      "title": "Bytes In / sec ({{TOPIC_NAME}})",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(kafka_topic_bytes_in_total{topic=\"{{TOPIC_NAME}}\"}[5m]))" }
      ]
    },
    {
      "id": 3,
      "title": "Partition Count ({{PARTITIONS}})",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "count(kafka_topic_partition_current_offset{topic=\"{{TOPIC_NAME}}\"})" }
      ]
    },
    {
      "id": 4,
      "title": "Consumer Group Lag ({{TOPIC_NAME}})",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum(kafka_consumergroup_lag{topic=\"{{TOPIC_NAME}}\"}) by (consumergroup)" }
      ]
    },
    {
      "id": 5,
      "title": "Retention (ms): {{RETENTION_MS}}",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 12 }
    }
  ]
}
