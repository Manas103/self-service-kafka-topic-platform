# A self-serve Kafka cluster request: the "20-line request" this control plane turns into a
# running 3-broker Kafka deployment with a TLS listener, a provisioned topic, and client quotas.
clusterName: payments-cluster
namespace: payments-demo
brokers: 3
topic: orders.events
partitions: 6
retentionMs: 3600000
producerQuotaBytesPerSec: 1048576
consumerQuotaBytesPerSec: 2097152
image: apache/kafka:3.7.1
